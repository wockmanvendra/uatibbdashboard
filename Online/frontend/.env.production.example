# Production build — copy to .env.production if you need to override
# anything for `npm run build` (Vite loads .env.production automatically
# in production mode).
#
# VITE_API_URL is required: it's the backend's absolute origin plus the
# /api namespace its routes are mounted under. This works whether the
# backend shares an origin with this build (see
# deploy/apache/d2d.conf.example) or is hosted on a separate domain/
# subdomain — either way, point this at wherever the API actually lives.
VITE_API_URL=https://uat.api.myownn.in/api


# Production server — copy to .env on the server and fill in real values.
# Never commit the real backend/.env (already gitignored).
#
# Topology: this Node process owns every route under the /api namespace
# — see backend/src/index.js. It may share one origin with the
# frontend behind a single Apache reverse proxy (see
# deploy/apache/d2d.conf.example), or the frontend may be hosted on a
# completely separate domain/subdomain (e.g. app.yourdomain.com talking to
# api.yourdomain.com). In the split-origin case, ALLOWED_ORIGINS below MUST
# list the frontend's real origin (cross-origin requests need CORS), and
# CCAVENUE_REDIRECT_URL / CCAVENUE_CANCEL_URL below must point at THIS
# service's own origin, not the frontend's.

# PostgreSQL connection — production database, not the dev one
PGHOST=localhost
PGPORT=5432
PGDATABASE=d2d_portal
PGUSER=d2d_app
PGPASSWORD=replace_with_the_production_db_password

# Server — PM2 binds this to localhost only; Apache is the public listener
PORT=3001
NODE_ENV=production

# CORS — the production domain(s) actually serving the frontend.
# Same-origin requests (browser -> Apache -> this app) don't need CORS at
# all, but keep this accurate in case anything calls the API directly.
ALLOWED_ORIGINS=https://yourdomain.com

# JWT auth — generate a fresh long random value, do NOT reuse the dev secret
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=6h

# Email notifications — NODE_ENV=production uses real SMTP; server will refuse
# to start if SMTP_HOST is blank. All four vars below are REQUIRED in production.
# SEND_EMAIL=false is a hard global kill switch — set it to stop all outbound
# email regardless of SMTP config (defaults to true/on when unset).
SEND_EMAIL=true
SMTP_HOST=          # e.g. smtp.gmail.com or your mail server
SMTP_PORT=587       # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=          # SMTP login / sender address
SMTP_PASSWORD=      # SMTP password or app-specific password
EMAIL_FROM=         # e.g. no-reply@yourdomain.com
FRONTEND_BASE_URL=https://yourdomain.com
OTP_EXPIRY_MINUTES=10

# CCAvenue payment gateway — real transactions.
# NOTE: the code checks CCAVENUE_ENV === 'prod' (not 'production') to select
# CCAVENUE_PROD_URL — keep this value exactly "prod".
MOCK_PAYMENT=false
CCAVENUE_ENV=prod
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_TEST_URL=https://test.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_PROD_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_REDIRECT_URL=https://api.yourdomain.com/api/payment/payment-redirect
CCAVENUE_CANCEL_URL=https://api.yourdomain.com/api/payment/payment-redirect

# Support contact shown to users when an order/customer action fails
ADMIN_CONTACT_MOBILE=

# SMS Gateway (SMSStriker — https://www.smsstriker.com/API/sms.php?)
# Leave SMS_URL blank to disable SMS sending entirely (service skips silently).
# SEND_SMS=false is a hard global kill switch — set it to stop all outbound
# SMS regardless of SMS_URL config (defaults to true/on when unset).
SEND_SMS=true
SMS_URL=https://www.smsstriker.com/API/sms.php?
SMS_USERNAME=
SMS_PWD=
SMS_FROM=           # DLT-registered sender ID (e.g. WCKSMS)
# DLT-registered template IDs — one per SMS event
SMS_TEMPLATE_OTP=

# Azure Blob Storage — file uploads (customer documents, product images, POD)
# Auth is an Azure AD service principal (no connection string / account key) —
# the service principal needs an RBAC role on the storage account/container
# that includes generateUserDelegationKey plus blob read/write (typically
# "Storage Blob Data Contributor"), assigned in the Azure Portal/CLI.
AZURE_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CONTAINER=
AZURE_SAS_EXPIRY_MINUTES=60

# Infinity Master Sync (Doctor/Chemist Master)
INFINITY_BASE_URL=https://infinityplus.wockhardt.com/plus/reports
INFINITY_REPORT_BASE_URL=https://infinityplus.wockhardt.com/plus/report
INFINITY_API_HEADER_NAME=
INFINITY_API_TOKEN=

# Local development — copy to .env and fill in your values
# (backend/.env is gitignored; this file is the committed template)

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=d2d_portal
PGUSER=postgres
PGPASSWORD=your_password_here

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed origins (Vite dev server ports)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5181

# JWT auth
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=6h

# Email notifications — NODE_ENV=development uses jsonTransport (emails logged
# to console, never sent). SMTP vars below are ignored in dev; fill them only
# if you temporarily want to test real sending by changing NODE_ENV=production.
# SEND_EMAIL=false is a hard global kill switch — set it to stop all outbound
# email regardless of SMTP config (defaults to true/on when unset).
SEND_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=test@gmail.com
FRONTEND_BASE_URL=http://localhost:5173
OTP_EXPIRY_MINUTES=10

# CCAvenue payment gateway — mocked in dev, no real merchant credentials needed
MOCK_PAYMENT=true
CCAVENUE_ENV=test
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
CCAVENUE_TEST_URL=https://test.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_PROD_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction
CCAVENUE_REDIRECT_URL=http://localhost:3001/api/payment/payment-redirect
CCAVENUE_CANCEL_URL=http://localhost:3001/api/payment/payment-redirect

# Support contact shown to users when an order/customer action fails
ADMIN_CONTACT_MOBILE=

# SMS Gateway (SMSStriker — https://www.smsstriker.com/API/sms.php?)
# Leave SMS_URL blank to disable SMS sending entirely (service skips silently).
# SEND_SMS=false is a hard global kill switch — set it to stop all outbound
# SMS regardless of SMS_URL config (defaults to true/on when unset).
SEND_SMS=true
SMS_URL=https://www.smsstriker.com/API/sms.php?
SMS_USERNAME=
SMS_PWD=
SMS_FROM=           # DLT-registered sender ID (e.g. WCKSMS)
# DLT-registered template IDs — one per SMS event
SMS_TEMPLATE_OTP=

# Azure Blob Storage — file uploads (customer documents, product images, POD)
# Auth is an Azure AD service principal (no connection string / account key) —
# the app requests a User Delegation SAS to hand out short-lived read links.
AZURE_STORAGE_ACCOUNT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CONTAINER=
AZURE_SAS_EXPIRY_MINUTES=60

# Infinity Master Sync (Doctor/Chemist Master)
INFINITY_BASE_URL=https://infinityplus.wockhardt.com/plus/reports
# Field Structure report API lives under /plus/report (singular), not /plus/reports
INFINITY_REPORT_BASE_URL=https://infinityplus.wockhardt.com/plus/report
# Optional auth header: set both to send INFINITY_API_HEADER_NAME: INFINITY_API_TOKEN on sync requests
INFINITY_API_HEADER_NAME=
INFINITY_API_TOKEN=

PORT=8787
NODE_ENV=development

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
#   serving-db      the intended architecture (ARCHITECTURE.md §4.0): a small
#                   Azure SQL database holding the agg_* tables that
#                   tools/etl.ts builds. Sub-20 ms queries.
#   synapse-direct  query the Synapse view directly. Sets aside invariant I9
#                   and costs 1-3 s per tab load. Chosen 2026-08-11 because no
#                   serving database is provisioned yet (§4.10).
DATA_SOURCE=synapse-direct

# Phase 1 only: serve the hardcoded contract mock instead of querying SQL.
USE_MOCK_DATA=false

SQL_SERVER=sap-analytics-sql1.sql.azuresynapse.net
SQL_DATABASE=WH_SAPdataAnalytics
SQL_USER=consultant_analytics_01
SQL_PASSWORD=Wock@123
SQL_ENCRYPT=true
# Against Synapse this also throttles concurrency-slot contention: a DW100c
# pool allows only four concurrent queries, so a large pool just moves the
# queue somewhere we cannot see it.
SQL_POOL_MAX=6

# The one table every dashboard figure is read from (schema.table).
DASHBOARD_TABLE=Infinity.Infinity_Reports

# ---------------------------------------------------------------------------
# Cache. With DATA_SOURCE=synapse-direct this is not an optimisation — it is
# what makes the dashboard usable at all.
# ---------------------------------------------------------------------------
REDIS_URL=
CACHE_DRIVER=memory            # memory | redis  (redis required from Phase 3)

AZURE_TENANT_ID=
AZURE_API_AUDIENCE=

# Signs session tokens: at least 32 characters; changing it signs everyone out.
# Required in production; elsewhere a built-in development secret is used if
# this is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_MAX_HOURS=8

# ---------------------------------------------------------------------------
# Sign-in: the user database (db/schema.sql) and OTP delivery
# ---------------------------------------------------------------------------
# Same PostgreSQL server as the D2D portal. The server's pg_hba.conf must allow
# this host. Create tables and views: npm run db:schema
USER_DATABASE_URL=postgres://postgres:<password>@192.168.1.76:5432/sales_dash_user_db
OTP_EXPIRY_MINUTES=10
AUTH_RATE_LIMIT=20

# Infinity field-structure API — who may sign in. Same values as the D2D
# portal's backend. npm run infinity:sync
INFINITY_REPORT_BASE_URL=https://infinityplus.wockhardt.com/plus/report
INFINITY_API_HEADER_NAME=Authorization
INFINITY_API_TOKEN=

# SMS (SMSStriker, as the D2D portal). SMS_OTP_TEXT must match the DLT
# template registered under SMS_TEMPLATE_ID exactly, with {otp} for the code.
# The D2D portal's template names "Wockhardtonline Portal", so the dashboard
# needs its own.
SMS_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=
SMS_TEMPLATE_ID=
SMS_OTP_TEXT=

# Email. SMTP_USER/PASSWORD are optional for an internal relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_INSECURE_TLS=false
EMAIL_FROM=

# Production needs SMS or email configured. Elsewhere, with neither, the code
# is returned by the API and shown on the login screen.

# Comma-separated. The web dev server runs on 5174 (5173 is taken on the
# current dev machine); dev requests are proxied same-origin anyway.
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
LOG_LEVEL=info
